{
  "permissions": {
    "allow": [
      "Bash(python -c ' *)",
      "Bash(python main_calculation.py)",
      "Bash(grep -rn \"Documents/Figures\\\\|Documents\\\\\\\\\\\\\\\\Figures\\\\|BASE_DIR\\\\|__file__\" Scripts/ --include=*.py)",
      "Bash(python -c \"import numpy as np; print\\(np.__version__\\)\")",
      "Bash(python \"Exemple 1.py\")",
      "Bash(awk 'NR==346,NR==361{printf \"%d:%s$\\\\n\", NR, $0}' \"Exemple 1.py\")"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f graphify-out/graph.json ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}}' || true"
          }
        ]
      }
    ]
  }
}
